    <application
        android:name=".CarBoxApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_box"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/ic_launcher_box"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CarBox"
        tools:targetApi="n">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 文件管理器里点击 APK 时可直接用宿主安装 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="application/vnd.android.package-archive"
                    android:scheme="content" />
            </intent-filter>
        </activity>

        <!-- 更新内容窗口：从顶部提示条点进来，显示版本信息 + 更新说明 html + 「立即更新」。
             exported=false：只由宿主自己（提示条 / BlackBox后台「更新应用」）拉起。 -->
        <activity
            android:name=".UpdateActivity"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- 宿主通知监听：系统只绑定真实安装的宿主组件（沙箱里的虚拟 app 组件不认识）。
             用途：系统重绑时拉起沙箱里的业务 APK（保活复活），并把通知事件交给 HostBridge。
             exported=true：部分车机 ROM 的通知使用权列表只显示 exported=true 的服务。 -->
        <service
            android:name=".HostNotificationListener"
            android:exported="true"
            android:label="业务应用通知服务"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 宿主无障碍服务：系统只绑定真实安装的宿主组件，沙箱业务的 AccessibilityService
             绑不上（"边缘手势"那套 performGlobalAction 在盒子里会失效）。
             业务经 FrameApi 的 access.perform 发命令，由这里代执行。
             exported=true + BIND_ACCESSIBILITY_SERVICE：系统绑定无障碍服务的必要条件。
             ⚠️ 需要在系统「无障碍」里手动开启一次（宿主 MainActivity 有入口跳转）。 -->
        <service
            android:name=".HostAccessibilityService"
            android:exported="true"
            android:label="业务应用辅助服务"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/host_accessibility_config" />
        </service>

        <!-- 调试用安装通道（adb 直接把 APK 推进沙箱，不用点界面）。
             exported=true：adb 只能显式发广播（-n 指定组件），这样 shell 才能送到。
             代码里还有一道闸：非 debug 构建直接 return，release 不生效。 -->
        <receiver
            android:name=".HostInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.anrays.yplus.action.INSTALL" />
                <action android:name="com.anrays.yplus.action.SET_ROOT" />
            </intent-filter>
        </receiver>

        <!-- 宿主的麦克风前台服务占位：沙箱内虚拟 app 与宿主同 UID，系统按 UID 判断
             "有没有 microphone FGS"，复活后要有它后台录音才不被静音。
             exported=false：shell 起不来，但 root 脚本的 am 能起（实测通过）。 -->
        <service
            android:name=".HostMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 开机/上电自启（车机无 root 时唯一可靠入口）。
             🔴 事件表**逐条对齐业务应用**（其 core/AppBootReceiver）：
                宿主只是它的载体，业务应用能靠这些广播起来，宿主就必须能靠同样的广播起来，
                否则盒子自己起不来、业务应用再能自启也没用。 -->
        <receiver
            android:name=".HostBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="ecarx.intent.action.power.STRMODE" />
                <action android:name="ecarx.intent.action.DISPLAY_ON" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.bluetooth.adapter.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="com.ecarx.intent.action.SYSTEM_READY" />
                <action android:name="com.ecarx.intent.action.ACC_ON" />
                <action android:name="com.ecarx.intent.action.IGN_ON" />
                <action android:name="com.ecarx.intent.action.WAKEUP" />
                <action android:name="com.ecarx.intent.action.STR_RESUME" />
                <action android:name="com.ecarx.intent.action.POWER_ON" />
                <action android:name="com.ecarx.systemui.SYSTEM_UI_READY" />
                <action android:name="com.lynkco.intent.action.SYSTEM_READY" />
                <action android:name="com.lynkco.intent.action.WAKEUP" />
                <action android:name="com.lynkco.intent.action.STR_RESUME" />
                <action android:name="com.geely.intent.action.SYSTEM_READY" />
                <action android:name="com.geely.intent.action.WAKEUP" />
                <action android:name="com.byd.action.ACC_ON" />
                <action android:name="com.byd.action.POWER_ON" />
                <action android:name="ecarx.xsf.mediacenter.action.BROADCAST_MEDIA_CENTER" />
            </intent-filter>
        </receiver>

        <!-- 沙箱业务应用→ 宿主的「立即更新」入口：业务在虚拟环境里 startService 到宿主
             真实组件（BlackBox 对真实包直接放行给系统 AMS），宿主据此下载 + 沙箱安装 + 回推进度。
             exported=false：调用方是沙箱业务（与宿主同 UID）。 -->
        <service
            android:name=".FrameUpdateHostService"
            android:exported="false" />

        <!-- root 守护脚本的拉活落点（见 HostKeepAlive / ReviveReceiver）：
             force-stop 后由脚本发显式广播唤醒进程，不创建 Activity，宿主不会跳到前台。
             exported=true 是必须的：调用方是 shell/root；显式广播不需要 intent-filter。 -->
        <receiver
            android:name=".ReviveReceiver"
            android:exported="true" />
    </application>
</manifest>
